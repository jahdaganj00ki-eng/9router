{
  "name": "9router-desktop",
  "version": "0.5.75",
  "private": true,
  "description": "9Router Windows desktop shell",
  "main": "main.js",
  "scripts": {
    "prepare:bundle": "node ../scripts/prepare-electron-standalone.mjs",
    "pack:dir": "npm run prepare:bundle && electron-builder --win --dir --publish never",
    "build:win": "npm run prepare:bundle && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.9router.desktop",
    "productName": "9Router",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../.build/electron-standalone",
        "to": "app",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "portable": {
      "artifactName": "9Router.${version}.portable.${ext}"
    },
    "nsis": {
      "artifactName": "9Router.Setup.${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
